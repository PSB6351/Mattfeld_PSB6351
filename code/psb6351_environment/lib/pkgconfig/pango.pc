prefix=/home/umcca001/Mattfeld_PSB6351/code/psb6351_environment
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Pango
Description: Internationalized text handling
Version: 1.58.2
Requires: gobject-2.0 >=  2.88, harfbuzz >=  11.0.0
Requires.private: glib-2.0 >=  2.88, gio-2.0 >=  2.88, fribidi >=  1.0.6, fontconfig >=  2.17.0, freetype2, cairo >=  1.18.0
Libs: -L${libdir} -lpango-1.0
Libs.private: -lm
Cflags: -I${includedir}/pango-1.0
