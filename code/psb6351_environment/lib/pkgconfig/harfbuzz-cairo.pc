prefix=/home/umcca001/Mattfeld_PSB6351/code/psb6351_environment
includedir=${prefix}/include
libdir=${prefix}/lib

Name: harfbuzz-cairo
Description: HarfBuzz cairo support
Version: 14.5.1
Requires: harfbuzz =  14.5.1
Requires.private: freetype2 >=  20.0.14, glib-2.0 >=  2.30.0, graphite2 >=  1.2.0, cairo >=  1.10.0
Libs: -L${libdir} -lharfbuzz-cairo
Libs.private: -lm -L${libdir} -lharfbuzz -pthread
Cflags: -I${includedir}/harfbuzz
