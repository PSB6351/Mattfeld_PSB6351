prefix=/home/umcca001/Mattfeld_PSB6351/code/psb6351_environment
includedir=${prefix}/include
libdir=${prefix}/lib

Name: cairo
Description: Multi-platform 2D graphics library
Version: 1.18.6
Requires.private: zlib, libpng >=  1.4.0, fontconfig >=  2.13.0, freetype2 >=  23.0.17, x11, xext, xrender >=  0.6, xcb >=  1.6, xcb-render >=  1.6, x11-xcb, xcb-shm, pixman-1 >=  0.40.0
Libs: -L${libdir} -lcairo
Libs.private: -lm -ldl
Cflags: -I${includedir}/cairo
