#!/bin/bash

# Setup Nipype, FSL, AFNI, Freesurfer, ANTs, R
module load fsl > /dev/null
module load ants > /dev/null
module load afni > /dev/null
module add r > /dev/null
module load cuda > /dev/null
module load gcc > /dev/null
module load dcm2niix > /dev/null

# Setup Freesurfer
export FREESURFER_HOME=/home/applications/freesurfer/7.1/freesurfer/
source $FREESURFER_HOME/FreeSurferEnv.sh
export SUBJECTS_DIR=~/Mattfeld_PSB6351/derivatives/freesurfer

# Setup ANTS path
export ANTSPATH=/home/applications/ANTs/2.3.5/bin
# Setup ANTs threading to 1
export ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1

# Setup Multithreading
export MKL_NUM_THREADS=4
export OMP_NUM_THREADS=4

# Setup project specific python environment
conda activate ~/Mattfeld_PSB6351/code/psb6351_environment
export PATH="$HOME/Mattfeld_PSB6351/code/psb6351_environment/bin:$PATH"
